import avunit_basic.osc
import adaptive.osc
# npc start lane/position aligned to scripts_with_setting/openscenario/s4_v1.xml (behaviour models and adaptive_targets still come from the generator)

# variant 1 of avunit_s4.osc (generated by gen_s4_variants.py, seed 2026)
# npc1  Script-normal
# npc2  Script-cautious
# npc3  AI-adv_ai_agent
# npc4  AI-adv_ai_agent
# adaptive_targets: npc2

scenario top:
    path: Path
    path.set_map("Town04")
    path.path_min_driving_lanes(2)

    ego_vehicle: Model3
    npc1: Rubicon
    npc2: TT
    npc3: A2
    npc4: TT

    adaptive_targets: list of string = [npc2]
    user_adaptive_npc_bm : string = adapt_npc_bm.adapt(scenario_mode: "avunit_s4")

    do parallel(duration: 40s):
        ego_vehicle.drive(path) with:
            set_behavior_model(behavior_type: Script, model: cautious, hyperparameters: Default)
            set_behavior_logic(
                lane:"3, at:start",
                position:"0, at:start",
                lane:"2, at:end",
                position:"150, at:end"
            )
        npc1.drive(path) with:
            set_behavior_model(behavior_type: Script, model:normal, hyperparameters: Default)
            set_behavior_logic(
                lane:"3, at:start",
                position:"[16..18], behind:ego_vehicle, at:start",
                lane:"[1..4], at:end",
                position:"[-20..30], ahead_of:ego_vehicle, at:end"
            )
        npc2.drive(path) with:
            set_behavior_model(behavior_type: Script, model:cautious, hyperparameters: Default)
            set_behavior_logic(
                lane:"3, at:start",
                position:"[5..6], behind:ego_vehicle, at:start",
                lane:"[1..4], at:end",
                position:"[-20..30], ahead_of:ego_vehicle, at:end"
            )
        npc3.drive(path) with:
            set_behavior_model(behavior_type: AI, model:adv_ai_agent, hyperparameters: Default)
            set_behavior_logic(
                lane:"4, at:start",
                position:"[10..12], behind:ego_vehicle, at:start",
                lane:"[1..4], at:end",
                position:"[-20..30], ahead_of:ego_vehicle, at:end"
            )
        npc4.drive(path) with:
            set_behavior_model(behavior_type: AI, model:adv_ai_agent, hyperparameters: Default)
            set_behavior_logic(
                lane:"4, at:start",
                position:"[17..19], behind:ego_vehicle, at:start",
                lane:"[1..4], at:end",
                position:"[-20..30], ahead_of:ego_vehicle, at:end"
            )
        auto_orchestrates_behavior(user_adaptive_npc_bm, adaptive_targets)
