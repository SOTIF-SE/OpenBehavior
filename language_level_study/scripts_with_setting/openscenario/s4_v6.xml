<?xml version="1.0"?>
<scenarios>
    <!-- OpenSCENARIO 1.0 version of s4.osc, variant 6 of 10.
         The ego drives on lane 4 of the opposite carriageway of road 36 (Town04) heading -y, so the NPCs
         are behind it when y = -87 + distance, on its right lane (x=409.1), left lane (x=402.1)
         or on its own lane (x=405.6).
         The ego rolename MUST be "ego_vehicle", it is what makes the scenario drive it with the
         BehaviorAgent (see WaypointFollower._is_ego).
         Run it with the scenario argument: S4SurroundOvertake_6  -->
    <scenario name="S4SurroundOvertake_6" type="S4SurroundOvertake" town="Town04">
        <ego_vehicle x="405.6" y="-87.0" z="0.3" yaw="270.6" model="vehicle.tesla.model3" rolename="ego_vehicle" />
        <other_actor x="402.1" y="-74.4" z="0.3" yaw="270.6" model="vehicle.jeep.wrangler_rubicon" /> <!-- left_of lane: 13 m behind -->
        <other_actor x="409.1" y="-80.9" z="0.3" yaw="270.6" model="vehicle.audi.tt" /> <!-- right_of lane: 6 m behind -->
        <other_actor x="402.1" y="-67.4" z="0.3" yaw="270.6" model="vehicle.audi.a2" /> <!-- left_of lane: 20 m behind -->
        <other_actor x="405.6" y="-84.0" z="0.3" yaw="270.6" model="vehicle.audi.tt" /> <!-- same_as lane: 3 m behind -->
        <weather cloudiness="0" precipitation="0" precipitation_deposits="0" wind_intensity="0" sun_azimuth_angle="0" sun_altitude_angle="75" />
    </scenario>
</scenarios>
